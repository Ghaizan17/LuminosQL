{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LuminosQL",
  "version": "0.1.3",
  "identifier": "dev.luminosql.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "LuminosQL — Database IDE", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": { "deb": {}, "rpm": {}, "appimage": {} },
    "windows": { "nsis": {} }
  }
}
